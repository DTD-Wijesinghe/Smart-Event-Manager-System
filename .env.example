PORT=4174
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=true
API_PREFIX=/api
ALLOWED_ORIGINS=*
# Use a local path during development, or paste the full JSON as a protected
# Render environment secret during deployment. Never commit either value.
VERTEX_SERVICE_ACCOUNT_JSON=./service-account.json
GCP_PROJECT=your-google-cloud-project
GCP_LOCATION=global
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_BATCH_MODEL=gemini-3.5-transcribe
GEMINI_LIVE_MODEL=gemini-3.5-transcribe-live
# Optional: use this instead of Vertex service-account credentials for Gemini
# Developer API access. Keep it server-side and never expose it in frontend code.
GEMINI_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
